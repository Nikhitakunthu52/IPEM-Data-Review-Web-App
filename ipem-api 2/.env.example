   DATA_MODE=mock
   API_KEY=change-me
   CORS_ORIGINS=http://localhost:5173

   # --- InfluxDB 1.8 (only needed when DATA_MODE=influx) ---
   INFLUX_URL=https://<lab-server>:8086
   INFLUX_USER=<username>
   INFLUX_PASSWORD=<password>
   INFLUX_DB=SP_Features
   INFLUX_MEASUREMENT=Features_v2
   INFLUX_MAC_TAG=location
   INFLUX_VERIFY_SSL=false

   FIELD_VOLTAGE=VF_RMS
   FIELD_CURRENT=IF_RMS
   FIELD_TEMPERATURE=

   # Temperature lives in a separate database, stored x10
   INFLUX_TEMP_DB=waveform
   INFLUX_TEMP_MEASUREMENT=temperature
   INFLUX_TEMP_FIELD=value
   INFLUX_TEMP_DIVISOR=10