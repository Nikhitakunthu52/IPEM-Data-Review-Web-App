# Copy this file to .env and fill in the values (never commit .env)

# mock = fake data (no server access needed), influx = real lab data
DATA_MODE=mock

# Shared key the web app sends in the X-API-Key header
API_KEY=dev-key

# Comma-separated list of web app origins allowed to call the API
# (local dev, and the GitHub Pages site once the API is on the lab server)
CORS_ORIGINS=http://localhost:5173,https://nikhitakunthu52.github.io

# --- InfluxDB 1.8 (only needed when DATA_MODE=influx) ---
INFLUX_URL=https://<lab-server>:8086
INFLUX_USER=<username>
INFLUX_PASSWORD=<password>
INFLUX_VERIFY_SSL=false

# Voltage and current come from Features_v2. Every other metric (temperature,
# power, THD, ...) comes from the waveform database. All of them, including
# divisors and units, are defined in the METRICS table in data.py.
INFLUX_DB=SP_Features
INFLUX_MEASUREMENT=Features_v2
INFLUX_WAVEFORM_DB=waveform
INFLUX_MAC_TAG=location
FIELD_VOLTAGE=VF_RMS
FIELD_CURRENT=IF_RMS